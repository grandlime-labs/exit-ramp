{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types"],
    "paths": { "cloudflare:workers": ["./stubs/cloudflare-workers.ts"] }
  },
  "include": ["./**/*.ts", "../templates/*.ts"]
}
